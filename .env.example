# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# Segurança: Princípio do Menor Privilégio
# ==========================================
# DATABASE_URL deve ser usado apenas para rodar migrações (Drizzle) e tem privilégios de Admin.
DATABASE_URL="postgres://postgres:password@localhost:5432/mock"

# APP_DATABASE_URL deve ser usado pela aplicação em tempo de execução.
# Este usuário ('app_user') tem acesso LIMITADO apenas a SELECT, INSERT, UPDATE e DELETE.
# Veja o script 'database_security_roles.sql' para referência de criação.
APP_DATABASE_URL="postgres://app_user:SenhaForteApp123@localhost:5432/mock"

# Em produção, a chave deve ter exatamente 32 bytes de entropia pura para o AES-256-GCM!
DATA_ENCRYPTION_KEY="sua_chave_criptografica_aqui_para_os_documentos"
